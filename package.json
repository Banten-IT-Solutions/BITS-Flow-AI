{
  "name": "bits-flow-ai",
  "version": "1.1.1",
  "description": "BITS Flow AI — isolated browser profiles for AI providers",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "compile:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --is-server 'typeof window === \"undefined\"'",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "^1.70.0",
    "@tauri-apps/api": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@inlang/paraglide-js": "^3.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "semantic-release": "^25.0.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
